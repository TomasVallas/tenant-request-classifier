# Copy this file to backend/.env and fill in only the provider you use.
# Never commit backend/.env.

# Model provider: fake | azure_openai | openai | anthropic
# "fake" is deterministic, needs no API key and costs nothing.
LLM_PROVIDER=fake

# Azure OpenAI (LLM_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# OpenAI (LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# The only browser origin allowed by CORS, in addition to localhost in development.
FRONTEND_ORIGIN=http://localhost:5173
